DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional: seed bootstraps the first admin user from these.
# Leave unset to use Payload's create-first-user screen instead.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Optional: the HQ Telegram bot's chat model (OpenRouter). Both must be set,
# or plain-text messages get the help reply. See HQ.md, "Chatting with the bot".
OPENROUTER_API_KEY=
HQ_CHAT_MODEL=
# HQ_CHAT_DAILY_LIMIT=50
# HQ_CHAT_MAX_TOKENS=500

# Postiz (lib/postiz.ts). POSTIZ_API_URL/KEY = the self-hosted Hetzner instance
# (https://postiz.flamingocounty.com/api/public/v1). POSTIZ_CLOUD_* = Postiz Cloud
# (https://api.postiz.com/public/v1). POSTIZ_NEW_POSTS=cloud sends newly approved
# drafts to Cloud; unset keeps them on Hetzner. See POSTIZ-CLOUD-MIGRATION.md.
# POSTIZ_API_URL=
# POSTIZ_API_KEY=
# POSTIZ_CLOUD_API_URL=https://api.postiz.com/public/v1
# POSTIZ_CLOUD_API_KEY=
# POSTIZ_NEW_POSTS=cloud

# Miami-Dade Transit live buses (Swiftly GTFS-rt, agency "miami"). Server only; 180 requests / 15 min.
SWIFTLY_API_KEY=
