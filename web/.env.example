DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional: seed bootstraps the first admin user from these.
# Leave unset to use Payload's create-first-user screen instead.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Optional: the HQ Telegram bot's chat model (OpenRouter). Both must be set,
# or plain-text messages get the help reply. See HQ.md, "Chatting with the bot".
OPENROUTER_API_KEY=
HQ_CHAT_MODEL=
# HQ_CHAT_DAILY_LIMIT=50
# HQ_CHAT_MAX_TOKENS=500
